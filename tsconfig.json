{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "site/.vitepress",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "jsx": "preserve",
    "types": ["node"]
  },
  "include": ["shims-vue.d.ts", "site/.vitepress/**/*"]
}
